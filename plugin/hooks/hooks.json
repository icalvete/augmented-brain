{
  "description": "augmented brain: load the space when a session starts, guard commands and file writes (and block them when the guard cannot run), remind the assistant to keep the task's journal and warn when the window uses too much memory, keep the summary when the conversation is compacted, and back the space up when a session ends.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$PATH:$HOME/.local/bin\" augmented-brain hook session-start 1",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "PATH=\"$PATH:$HOME/.local/bin\" augmented-brain hook session-start 2",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "PATH=\"$PATH:$HOME/.local/bin\" augmented-brain hook session-start 3",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "PATH=\"$PATH:$HOME/.local/bin\" augmented-brain hook session-start 4",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "PATH=\"$PATH:$HOME/.local/bin\" augmented-brain hook session-start 5",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "PATH=\"$PATH:$HOME/.local/bin\" augmented-brain hook session-start 6",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "PATH=\"$PATH:$HOME/.local/bin\" augmented-brain hook session-start 7",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "PATH=\"$PATH:$HOME/.local/bin\" augmented-brain hook session-start 8",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "PATH=\"$PATH:$HOME/.local/bin\" augmented-brain hook session-start 9",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$PATH:$HOME/.local/bin\" augmented-brain hook pre-tool-use",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$PATH:$HOME/.local/bin\" augmented-brain hook stop",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$PATH:$HOME/.local/bin\" augmented-brain hook post-compact",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$PATH:$HOME/.local/bin\" augmented-brain hook session-end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
