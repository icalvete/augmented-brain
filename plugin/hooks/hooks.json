{
  "description": "augmented brain: load the space when a session starts, guard commands and file writes, remind the assistant to keep the task's journal, keep the summary when the conversation is compacted, and back the space up when a session ends.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$PATH:$HOME/.local/bin\" augmented-brain hook session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$PATH:$HOME/.local/bin\" augmented-brain hook pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$PATH:$HOME/.local/bin\" augmented-brain hook stop",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$PATH:$HOME/.local/bin\" augmented-brain hook post-compact",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$PATH:$HOME/.local/bin\" augmented-brain hook session-end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
